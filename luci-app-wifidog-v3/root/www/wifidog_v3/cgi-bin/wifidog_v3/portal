#!/usr/bin/env lua

local function trim(s)
	return (s or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function shell_quote(s)
	s = tostring(s or "")
	return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function run(cmd)
	os.execute(cmd .. " >/dev/null 2>&1")
end

local LOG_FILE = "/var/log/wifidog_v3.log"

local function append_runtime_log(message)
	message = tostring(message or ""):gsub("[\r\n]", " "):sub(1, 512)
	if message == "" then
		return
	end
	local fp = io.open(LOG_FILE, "a")
	if fp then
		fp:write(os.date("%Y-%m-%d %H:%M:%S"), " [portal] ", message, "\n")
		fp:close()
	end
	run("logger -t wifidog_v3 " .. shell_quote(message))
end

local function read_cmd(cmd)
	local fp = io.popen(cmd .. " 2>/dev/null")
	if not fp then
		return ""
	end
	local data = fp:read("*a") or ""
	fp:close()
	return trim(data)
end

local function uci_get(path, default)
	local value = read_cmd("uci -q get " .. shell_quote(path))
	if value == "" then
		return default or ""
	end
	return value
end

local function uci_set(expr)
	run("uci -q set " .. shell_quote(expr))
end

local function uci_delete(path)
	run("uci -q delete " .. shell_quote(path))
end

local function uci_commit()
	run("uci -q commit wifidog_v3")
end

local function get_router_ip()
	return uci_get("network.lan.ipaddr", "192.168.1.1")
end

local function get_portal_port()
	return uci_get("wifidog_v3.settings.portal_port", "8080")
end

local function normalize_auth_minutes(value)
	value = trim(value or "")
	if value == "" then
		return nil
	end
	if not value:match("^%d+$") then
		return nil
	end
	local minutes = tonumber(value)
	if not minutes or minutes < 1 or minutes > 525600 then
		return nil
	end
	return math.floor(minutes)
end

local function normalize_auth_seconds(value)
	value = trim(value or "")
	if value == "" then
		return nil
	end
	if not value:match("^%d+$") then
		return nil
	end
	local seconds = tonumber(value)
	if not seconds or seconds < 1 or seconds > 31536000 then
		return nil
	end
	return math.floor(seconds)
end

local function effective_auth_seconds(auth_minutes, auth_seconds)
	local seconds = normalize_auth_seconds(auth_seconds)
	if seconds then
		return seconds
	end

	local timeout = normalize_auth_minutes(auth_minutes)
	if not timeout then
		timeout = tonumber(uci_get("wifidog_v3.settings.auth_timeout", "1440")) or 1440
	end
	if timeout < 1 then
		timeout = 1440
	end
	return math.floor(timeout * 60)
end

local function portal_base_url()
	local router_ip = get_router_ip()
	local portal_port = get_portal_port()
	if portal_port == "" or portal_port == "80" then
		return "http://" .. router_ip
	end
	return "http://" .. router_ip .. ":" .. portal_port
end

local function reload_firewall()
	run("/etc/init.d/wifidog_v3 reload")
end

local function urldecode(s)
	s = tostring(s or "")
	s = s:gsub("+", " ")
	s = s:gsub("%%(%x%x)", function(hex)
		return string.char(tonumber(hex, 16))
	end)
	return s
end

local function parse_form(body)
	local form = {}
	for pair in tostring(body or ""):gmatch("[^&]+") do
		local key, value = pair:match("^([^=]*)=?(.*)$")
		if key and key ~= "" then
			form[urldecode(key)] = urldecode(value or "")
		end
	end
	return form
end

local function json_escape(s)
	s = tostring(s or "")
	s = s:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\r", "\\r"):gsub("\n", "\\n")
	return s
end

local function format_duration(seconds)
	seconds = tonumber(seconds or "0") or 0
	if seconds < 1 then
		return ""
	end
	local days = math.floor(seconds / 86400)
	local hours = math.floor((seconds % 86400) / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	if seconds % 60 > 0 and minutes < 59 then
		minutes = minutes + 1
	end
	if days > 0 then
		if hours > 0 then
			return tostring(days) .. "天" .. tostring(hours) .. "小时"
		end
		return tostring(days) .. "天"
	end
	if hours > 0 then
		if minutes > 0 then
			return tostring(hours) .. "小时" .. tostring(minutes) .. "分钟"
		end
		return tostring(hours) .. "小时"
	end
	return tostring(math.max(1, minutes)) .. "分钟"
end

local function auth_success_json(redirect_url, expiry, valid_seconds)
	expiry = tonumber(expiry or "0") or 0
	valid_seconds = tonumber(valid_seconds or "0") or 0
	local expires_at_text = ""
	if expiry > 0 then
		expires_at_text = os.date("%Y-%m-%d %H:%M:%S", expiry)
	end
	return '{"success":true,"message":"认证成功","wait_seconds":3,"api_url":"/captive-portal/api","completion_url":"http://captive.apple.com/hotspot-detect.html","redirect":"'
		.. json_escape(redirect_url or "")
		.. '","expires_at":' .. tostring(expiry)
		.. ',"expires_at_text":"' .. json_escape(expires_at_text)
		.. '","valid_seconds":' .. tostring(valid_seconds)
		.. ',"valid_text":"' .. json_escape(format_duration(valid_seconds)) .. '"}'
end

local function html_escape(s)
	s = tostring(s or "")
	s = s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&#39;")
	return s
end

local function html_escape_multiline(s)
	return html_escape(s):gsub("\r\n", "\n"):gsub("\r", "\n"):gsub("\n", "<br>")
end

local function clean_text(s, max_len)
	s = tostring(s or "")
	s = s:gsub("[%z\001-\008\011\012\014-\031\127]", " ")
	if max_len and #s > max_len then
		s = s:sub(1, max_len)
	end
	return s
end

local function clean_user_agent_token(s, max_len)
	s = clean_text(s, max_len or 128):gsub("^%s+", ""):gsub("%s+$", "")
	s = s:gsub("%s+", " ")
	return s
end

local function ua_version(value)
	value = tostring(value or ""):gsub("_", ".")
	return value:gsub("[^%d%.].*$", "")
end

local function parse_user_agent(ua)
	ua = clean_user_agent_token(ua, 512)
	local lower = ua:lower()
	local info = {
		os = "未知",
		browser = "未知",
		device_type = "未知",
		model = "未知"
	}

	if ua == "" then
		info.summary = "未知设备"
		return info
	end

	if lower:find("bot", 1, true) or lower:find("spider", 1, true) or lower:find("crawler", 1, true) then
		info.device_type = "机器人"
	end

	if ua:find("iPhone", 1, true) then
		info.device_type = "手机"
		info.model = "iPhone"
		local version = ua:match("iPhone OS ([%d_%.]+)")
		info.os = version and ("iOS " .. ua_version(version)) or "iOS"
	elseif ua:find("iPad", 1, true) then
		info.device_type = "平板"
		info.model = "iPad"
		local version = ua:match("CPU OS ([%d_%.]+)")
		info.os = version and ("iPadOS " .. ua_version(version)) or "iPadOS"
	elseif ua:find("iPod", 1, true) then
		info.device_type = "手机"
		info.model = "iPod touch"
		local version = ua:match("iPhone OS ([%d_%.]+)")
		info.os = version and ("iOS " .. ua_version(version)) or "iOS"
	elseif ua:find("Android", 1, true) then
		local version = ua:match("Android%s+([%d%.]+)")
		info.os = version and ("Android " .. ua_version(version)) or "Android"
		info.device_type = ua:find("Mobile", 1, true) and "手机" or "平板"
		local model = ua:match("Android%s+[%d%.]+;%s*([^;%)]+)%s+Build/")
			or ua:match("Android%s+[%d%.]+;%s*([^;%)]+)[;)]")
			or ""
		model = clean_user_agent_token(model, 96)
		if model == "" or model == "wv" or model == "K" or model:lower():find("^zh") or model:lower():find("^en") then
			model = "Android设备"
		end
		info.model = model
	elseif ua:find("Windows NT", 1, true) then
		info.device_type = "电脑"
		info.model = "Windows PC"
		local nt = ua:match("Windows NT ([%d%.]+)")
		if nt == "10.0" then
			info.os = "Windows 10/11"
		elseif nt then
			info.os = "Windows NT " .. nt
		else
			info.os = "Windows"
		end
	elseif ua:find("CrOS", 1, true) then
		info.device_type = "电脑"
		info.model = "Chromebook"
		local version = ua:match("CrOS [^%s]+ ([%d%.]+)")
		info.os = version and ("ChromeOS " .. ua_version(version)) or "ChromeOS"
	elseif ua:find("Macintosh", 1, true) or ua:find("Mac OS X", 1, true) then
		if ua:find("Mobile/", 1, true) and ua:find("Safari/", 1, true) then
			info.device_type = "平板"
			info.model = "iPad"
			info.os = "iPadOS"
		else
			info.device_type = "电脑"
			info.model = "Mac"
			local version = ua:match("Mac OS X ([%d_%.]+)")
			info.os = version and ("macOS " .. ua_version(version)) or "macOS"
		end
	elseif ua:find("Linux", 1, true) then
		info.device_type = info.device_type ~= "未知" and info.device_type or "电脑"
		info.model = "Linux PC"
		info.os = "Linux"
	end

	local browser, version
	if ua:find("MicroMessenger/", 1, true) then
		version = ua:match("MicroMessenger/([%d%.]+)")
		browser = "微信内置浏览器"
	elseif ua:find("EdgA/", 1, true) or ua:find("EdgiOS/", 1, true) or ua:find("Edg/", 1, true) then
		version = ua:match("EdgA/([%d%.]+)") or ua:match("EdgiOS/([%d%.]+)") or ua:match("Edg/([%d%.]+)")
		browser = "Edge"
	elseif ua:find("OPR/", 1, true) or ua:find("Opera/", 1, true) then
		version = ua:match("OPR/([%d%.]+)") or ua:match("Opera/([%d%.]+)")
		browser = "Opera"
	elseif ua:find("SamsungBrowser/", 1, true) then
		version = ua:match("SamsungBrowser/([%d%.]+)")
		browser = "Samsung Browser"
	elseif ua:find("HuaweiBrowser/", 1, true) then
		version = ua:match("HuaweiBrowser/([%d%.]+)")
		browser = "Huawei Browser"
	elseif ua:find("MiuiBrowser/", 1, true) then
		version = ua:match("MiuiBrowser/([%d%.]+)")
		browser = "小米浏览器"
	elseif ua:find("CriOS/", 1, true) then
		version = ua:match("CriOS/([%d%.]+)")
		browser = "Chrome iOS"
	elseif ua:find("Chrome/", 1, true) then
		version = ua:match("Chrome/([%d%.]+)")
		browser = "Chrome"
	elseif ua:find("FxiOS/", 1, true) then
		version = ua:match("FxiOS/([%d%.]+)")
		browser = "Firefox iOS"
	elseif ua:find("Firefox/", 1, true) then
		version = ua:match("Firefox/([%d%.]+)")
		browser = "Firefox"
	elseif ua:find("Version/", 1, true) and ua:find("Safari/", 1, true) then
		version = ua:match("Version/([%d%.]+)")
		browser = "Safari"
	elseif ua:find("CaptiveNetworkSupport", 1, true) or lower:find("captive", 1, true) then
		browser = "Captive Portal 探测"
	end
	if browser then
		info.browser = version and (browser .. " " .. ua_version(version)) or browser
	end

	local parts = {}
	if info.model ~= "" and info.model ~= "未知" then parts[#parts + 1] = info.model end
	if info.os ~= "" and info.os ~= "未知" then parts[#parts + 1] = info.os end
	if info.browser ~= "" and info.browser ~= "未知" then parts[#parts + 1] = info.browser end
	if #parts == 0 then
		parts[#parts + 1] = info.device_type ~= "未知" and info.device_type or "未知设备"
	end
	info.summary = table.concat(parts, " / ")
	return info
end

local function is_generic_user_agent(ua)
	local lower = tostring(ua or ""):lower()
	return lower == ""
		or lower:find("uclient-fetch", 1, true) ~= nil
		or lower:find("wget", 1, true) ~= nil
		or lower:find("curl", 1, true) ~= nil
		or lower:find("python-requests", 1, true) ~= nil
		or lower:find("go-http-client", 1, true) ~= nil
		or lower:find("libwww", 1, true) ~= nil
end

local function setting_text(key, default, max_len)
	local value = uci_get("wifidog_v3.settings." .. key, "")
	if value == "" then
		value = default or ""
	end
	return clean_text(value, max_len)
end

local function option_enabled(key, default)
	local value = uci_get("wifidog_v3.settings." .. key, default or "0")
	return value == "1" or value == "true" or value == "on" or value == "yes"
end

local function pack_u16(n)
	n = tonumber(n) or 0
	return string.char(math.floor(n / 256) % 256, n % 256)
end

local function pack_u32(n)
	n = tonumber(n) or 0
	return string.char(
		math.floor(n / 16777216) % 256,
		math.floor(n / 65536) % 256,
		math.floor(n / 256) % 256,
		n % 256
	)
end

local function unpack_u16(s, pos)
	local a, b = s:byte(pos, pos + 1)
	if not a or not b then
		return nil
	end
	return a * 256 + b
end

local function unpack_u32(s, pos)
	local a, b, c, d = s:byte(pos, pos + 3)
	if not a or not b or not c or not d then
		return nil
	end
	return ((a * 256 + b) * 256 + c) * 256 + d
end

local function ipv4_bytes(ip)
	local a, b, c, d = tostring(ip or ""):match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
	a, b, c, d = tonumber(a), tonumber(b), tonumber(c), tonumber(d)
	if not a or not b or not c or not d or a > 255 or b > 255 or c > 255 or d > 255 then
		return nil
	end
	return string.char(a, b, c, d)
end

local function random_bytes(len)
	local fp = io.open("/dev/urandom", "rb")
	if fp then
		local data = fp:read(len)
		fp:close()
		if data and #data == len then
			return data
		end
	end

	math.randomseed(os.time() + tonumber(tostring({}):match("0x(%x+)") or "0", 16))
	local out = {}
	for i = 1, len do
		out[i] = string.char(math.random(0, 255))
	end
	return table.concat(out)
end

local function md5_binary(data)
	local unique = tostring({}):gsub("[^0-9A-Fa-f]", "")
	local name = "/tmp/wifidog_v3_md5_" .. tostring(os.time()) .. "_" .. unique
	local fp = io.open(name, "wb")
	if not fp then
		return nil, "无法创建临时文件"
	end
	fp:write(data)
	fp:close()

	local hex = read_cmd("md5sum " .. shell_quote(name) .. " | awk '{print $1}'")
	os.remove(name)
	if not hex or not hex:match("^%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x$") then
		return nil, "无法计算MD5"
	end

	local bytes = {}
	for i = 1, 32, 2 do
		bytes[#bytes + 1] = string.char(tonumber(hex:sub(i, i + 1), 16))
	end
	return table.concat(bytes)
end

local function bxor_byte(a, b)
	local result = 0
	local bit_value = 1
	while a > 0 or b > 0 do
		local abit = a % 2
		local bbit = b % 2
		if abit ~= bbit then
			result = result + bit_value
		end
		a = math.floor(a / 2)
		b = math.floor(b / 2)
		bit_value = bit_value * 2
	end
	return result
end

local function xor_strings(a, b)
	local out = {}
	for i = 1, #a do
		out[i] = string.char(bxor_byte(a:byte(i), b:byte(i)))
	end
	return table.concat(out)
end

