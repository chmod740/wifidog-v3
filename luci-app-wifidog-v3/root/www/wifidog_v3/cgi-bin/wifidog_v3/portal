local function mac_to_section(mac)
	return tostring(mac or ""):lower():gsub(":", "_")
end

local IP_SESSION_FILE = "/tmp/wifidog_v3_ip_sessions"
local IP_SESSION_TTL = 600

local function valid_ipv4(ip)
	local a, b, c, d = tostring(ip or ""):match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
	if not a then
		return false
	end
	a, b, c, d = tonumber(a), tonumber(b), tonumber(c), tonumber(d)
	return a and b and c and d and a <= 255 and b <= 255 and c <= 255 and d <= 255
end

local function get_client_ip()
	return os.getenv("REMOTE_ADDR") or ""
end

local function get_client_mac(client_ip)
	if not client_ip or client_ip == "" then
		return ""
	end

	local arp = io.open("/proc/net/arp", "r")
	if arp then
		arp:read("*l")
		for line in arp:lines() do
			local ip, _, _, mac = line:match("^(%S+)%s+(%S+)%s+(%S+)%s+(%S+)")
			if ip == client_ip and mac and mac ~= "00:00:00:00:00:00" then
				arp:close()
				return mac:upper()
			end
		end
		arp:close()
	end

	local leases = io.open("/tmp/dhcp.leases", "r")
	if leases then
		for line in leases:lines() do
			local _, mac, ip = line:match("^(%d+)%s+(%S+)%s+(%S+)")
			if ip == client_ip and mac then
				leases:close()
				return mac:upper()
			end
		end
		leases:close()
	end

	return ""
end

local function iter_uci_sections()
	local out = read_cmd("uci -q show wifidog_v3")
	local sections = {}

	for line in out:gmatch("[^\n]+") do
		local section, opt, value = line:match("^wifidog_v3%.([^%.=]+)%.([^=]+)='?(.-)'?$")
		if section and opt then
			value = value:gsub("'$", "")
			sections[section] = sections[section] or {}
			sections[section][opt] = value
		else
			local type_section, stype = line:match("^wifidog_v3%.([^=]+)='?(.-)'?$")
			if type_section and stype then
				stype = stype:gsub("'$", "")
				sections[type_section] = sections[type_section] or {}
				sections[type_section][".type"] = stype
			end
		end
	end

	return sections
end

local function get_device_by_mac(mac)
	local target = tostring(mac or ""):upper()
	if target == "" then
		return nil
	end

	for name, section in pairs(iter_uci_sections()) do
		if section[".type"] == "device" and section.mac and tostring(section.mac):upper() == target then
			section[".name"] = name
			return section
		end
	end

	return nil
end

local function record_client_user_agent(mac, ip, path)
	local ua = clean_user_agent_token(os.getenv("HTTP_USER_AGENT") or "", 512)
	if ua == "" or not mac or mac == "" then
		return
	end

	mac = tostring(mac):upper()
	local now = os.time()
	local section = mac_to_section(mac)
	local existing = get_device_by_mac(mac)
	if existing and (existing.user_agent or "") ~= "" and existing.user_agent ~= ua then
		if is_generic_user_agent(ua) and not is_generic_user_agent(existing.user_agent) then
			return
		end
		if tostring(path or "") ~= "/portal" then
			return
		end
	end
	local old_summary = existing and existing.ua_summary or ""
	local last_seen = tonumber((existing and existing.ua_seen) or "0") or 0
	if existing and existing.user_agent == ua and tostring(existing.ip or "") == tostring(ip or "") and now - last_seen < 300 then
		return
	end

	local parsed = parse_user_agent(ua)
	if not existing then
		uci_set("wifidog_v3." .. section .. "=device")
		uci_set("wifidog_v3." .. section .. ".mac=" .. mac)
		uci_set("wifidog_v3." .. section .. ".type=pending")
		uci_set("wifidog_v3." .. section .. ".auth_expiry=0")
		uci_set("wifidog_v3." .. section .. ".created=" .. tostring(now))
	else
		section = existing[".name"] or section
	end
	if ip and ip ~= "" then
		uci_set("wifidog_v3." .. section .. ".ip=" .. clean_text(ip, 64))
	end
	uci_set("wifidog_v3." .. section .. ".user_agent=" .. ua)
	uci_set("wifidog_v3." .. section .. ".ua_device_type=" .. clean_text(parsed.device_type, 32))
	uci_set("wifidog_v3." .. section .. ".ua_os=" .. clean_text(parsed.os, 64))
	uci_set("wifidog_v3." .. section .. ".ua_browser=" .. clean_text(parsed.browser, 64))
	uci_set("wifidog_v3." .. section .. ".ua_model=" .. clean_text(parsed.model, 96))
	uci_set("wifidog_v3." .. section .. ".ua_summary=" .. clean_text(parsed.summary, 192))
	uci_set("wifidog_v3." .. section .. ".ua_seen=" .. tostring(now))
	uci_commit()

	if old_summary ~= parsed.summary then
		append_runtime_log("识别到设备UA MAC=" .. mac .. " IP=" .. tostring(ip or "") .. " 设备=" .. parsed.summary)
	end
end

local function load_ip_sessions()
	local sessions = {}
	local now = os.time()
	local changed = false
	local fp = io.open(IP_SESSION_FILE, "r")
	if not fp then
		return sessions, false
	end

	for line in fp:lines() do
		local expires, ip, mac = line:match("^(%d+)%s+(%S+)%s+(%S+)")
		expires = tonumber(expires or "0") or 0
		if expires > now and valid_ipv4(ip) and mac and mac ~= "" then
			sessions[ip] = { expires = expires, mac = mac:upper() }
		else
			changed = true
		end
	end
	fp:close()
	return sessions, changed
end

local function save_ip_sessions(sessions)
	local fp = io.open(IP_SESSION_FILE, "w")
	if not fp then
		return
	end

	for ip, item in pairs(sessions or {}) do
		if valid_ipv4(ip) and item and item.mac and tonumber(item.expires or "0") then
			fp:write(tostring(item.expires), " ", ip, " ", tostring(item.mac):upper(), "\n")
		end
	end
	fp:close()
end

local function remember_ip_session(ip, mac, auth_expiry)
	if not valid_ipv4(ip) or not mac or mac == "" then
		return
	end

	local now = os.time()
	local expires = now + IP_SESSION_TTL
	local device_expiry = tonumber(auth_expiry or "0") or 0
	if device_expiry > now and device_expiry < expires then
		expires = device_expiry
	end
	if expires <= now then
		return
	end

	local sessions = load_ip_sessions()
	sessions[ip] = { expires = expires, mac = tostring(mac):upper() }
	save_ip_sessions(sessions)
end

local function forget_ip_session(ip)
	if not valid_ipv4(ip) then
		return
	end

	local sessions = load_ip_sessions()
	if sessions[ip] then
		sessions[ip] = nil
		save_ip_sessions(sessions)
	end
end

local function radius_attr(attr_type, value)
	value = tostring(value or "")
	if #value > 253 then
		value = value:sub(1, 253)
	end
	return string.char(attr_type, #value + 2) .. value
end

local function radius_encrypt_password(password, secret, authenticator)
	password = tostring(password or "")
	secret = tostring(secret or "")
	if #password > 128 then
		password = password:sub(1, 128)
	end
	local pad_len = 16 - (#password % 16)
	if pad_len == 16 and #password > 0 then
		pad_len = 0
	end
	password = password .. string.rep("\0", pad_len)
	if #password == 0 then
		password = string.rep("\0", 16)
	end

	local encrypted = {}
	local previous = authenticator
	for pos = 1, #password, 16 do
		local digest, err = md5_binary(secret .. previous)
		if not digest then
			return nil, err
		end
		local block = password:sub(pos, pos + 15)
		local cipher = xor_strings(block, digest)
		encrypted[#encrypted + 1] = cipher
		previous = cipher
	end
	return table.concat(encrypted)
end

local function radius_parse_attrs(data, start_pos)
	local attrs = {}
	local pos = start_pos or 21
	while pos <= #data do
		local attr_type = data:byte(pos)
		local attr_len = data:byte(pos + 1)
		if not attr_type or not attr_len or attr_len < 2 or pos + attr_len - 1 > #data then
			break
		end
		local value = data:sub(pos + 2, pos + attr_len - 1)
		attrs[#attrs + 1] = { type = attr_type, value = value }
		pos = pos + attr_len
	end
	return attrs
end

local function radius_authenticate(username, password, client_mac, client_ip)
	username = clean_text(username, 128)
	password = tostring(password or "")
	if username == "" then
		return false, "请输入用户名"
	end
	if password == "" then
		return false, "请输入密码"
	end

	local server = uci_get("wifidog_v3.settings.radius_server", "")
	local secret = uci_get("wifidog_v3.settings.radius_secret", "")
	if server == "" or secret == "" then
		return false, "RADIUS服务器未配置"
	end

	local socket_ok, socket = pcall(require, "socket")
	if not socket_ok or not socket or not socket.udp then
		return false, "系统缺少LuaSocket，无法进行RADIUS认证"
	end

	local port = tonumber(uci_get("wifidog_v3.settings.radius_port", "1812")) or 1812
	local timeout = tonumber(uci_get("wifidog_v3.settings.radius_timeout", "3")) or 3
	local retries = tonumber(uci_get("wifidog_v3.settings.radius_retries", "1")) or 1
	local nas_id = uci_get("wifidog_v3.settings.radius_nas_id", "wifidog-v3")
	if nas_id == "" then
		nas_id = "wifidog-v3"
	end

	local request_auth = random_bytes(16)
	local password_attr, password_err = radius_encrypt_password(password, secret, request_auth)
	if not password_attr then
		return false, password_err or "RADIUS密码加密失败"
	end

	local attrs = {
		radius_attr(1, username),
		radius_attr(2, password_attr),
		radius_attr(31, tostring(client_mac or "")),
		radius_attr(32, nas_id),
		radius_attr(6, pack_u32(1))
	}
	local nas_ip = ipv4_bytes(get_router_ip())
	if nas_ip then
		attrs[#attrs + 1] = radius_attr(4, nas_ip)
	end
	local framed_ip = ipv4_bytes(client_ip)
	if framed_ip then
		attrs[#attrs + 1] = radius_attr(8, framed_ip)
	end

	local attr_data = table.concat(attrs)
	local packet_id = random_bytes(1):byte(1) or math.random(0, 255)
	local packet = string.char(1, packet_id) .. pack_u16(20 + #attr_data) .. request_auth .. attr_data
	local udp = socket.udp()
	if not udp then
		return false, "无法创建RADIUS UDP连接"
	end
	udp:settimeout(timeout)

	local response
	for _ = 1, math.max(1, retries) do
		udp:sendto(packet, server, port)
		response = udp:receivefrom()
		if response and #response >= 20 then
			break
		end
	end
	udp:close()

	if not response or #response < 20 then
		return false, "RADIUS服务器无响应"
	end

	local code = response:byte(1)
	local response_id = response:byte(2)
	local response_len = unpack_u16(response, 3)
	if response_id ~= packet_id or not response_len or response_len > #response or response_len < 20 then
		return false, "RADIUS响应格式无效"
	end
	response = response:sub(1, response_len)

	local response_attrs = response:sub(21)
	local expected_auth = md5_binary(string.char(code, response_id) .. pack_u16(response_len) .. request_auth .. response_attrs .. secret)
	if not expected_auth or response:sub(5, 20) ~= expected_auth then
		return false, "RADIUS响应校验失败"
	end

	if code == 3 then
		return false, "RADIUS认证失败"
	end
	if code ~= 2 then
		return false, "RADIUS服务器拒绝认证"
	end

	local session_timeout = ""
	for _, attr in ipairs(radius_parse_attrs(response, 21)) do
		if attr.type == 27 and #attr.value == 4 then
			session_timeout = tostring(unpack_u32(attr.value, 1) or "")
			break
		end
	end

	return true, "认证成功", username, session_timeout
end

local function validate_auth_code(code)
	code = tostring(code or ""):upper()
	if code == "" then
		return false, "请输入授权码"
	end

	local found_name, found
	for name, section in pairs(iter_uci_sections()) do
		if section[".type"] == "authcode" and tostring(section.code or ""):upper() == code then
			found_name = name
			found = section
			break
		end
	end

	if not found then
		return false, "授权码无效"
	end
	if found.enabled ~= "1" then
		return false, "授权码已被禁用"
	end

	local max_uses = tonumber(found.max_uses or "1") or 1
	local used_count = tonumber(found.used_count or "0") or 0
	if used_count >= max_uses then
		return false, "授权码使用次数已用完"
	end

	local created_date = found.created_date or ""
	local expiry_days = tonumber(found.expiry_days or "30") or 30
	local year, month, day = created_date:match("^(%d+)-(%d+)-(%d+)$")
	if year and month and day then
		local created = os.time({ year = tonumber(year), month = tonumber(month), day = tonumber(day), hour = 0 })
		if created and os.time() > created + expiry_days * 86400 then
			return false, "授权码已过期"
		end
	end

	uci_set("wifidog_v3." .. found_name .. ".used_count=" .. tostring(used_count + 1))
	uci_commit()
	return true, "认证成功", code, found.auth_minutes or ""
end

local function delete_devices_by_mac(mac)
	local target = tostring(mac or ""):upper()
	for name, section in pairs(iter_uci_sections()) do
		if section[".type"] == "device" and section.mac and tostring(section.mac):upper() == target then
			uci_delete("wifidog_v3." .. name)
		end
	end
end

local function authorize_client(mac, ip, source, auth_code, auth_minutes, auth_seconds)
	if not mac or mac == "" then
		return false
	end

	local saved = get_device_by_mac(mac) or {}
	local timeout = effective_auth_seconds(auth_minutes, auth_seconds)
	local now = os.time()
	local expiry = now + timeout
	local section = mac_to_section(mac)
	local auth_source = tostring(source or "code")

	delete_devices_by_mac(mac)
	uci_set("wifidog_v3." .. section .. "=device")
	uci_set("wifidog_v3." .. section .. ".mac=" .. mac:upper())
	uci_set("wifidog_v3." .. section .. ".ip=" .. tostring(ip or ""))
	uci_set("wifidog_v3." .. section .. ".type=authorized")
	uci_set("wifidog_v3." .. section .. ".auth_expiry=" .. tostring(expiry))
	uci_set("wifidog_v3." .. section .. ".auth_source=" .. auth_source)
	if auth_source == "radius" then
		uci_set("wifidog_v3." .. section .. ".auth_code=")
		uci_set("wifidog_v3." .. section .. ".radius_user=" .. clean_text(auth_code or "", 128))
	else
		uci_set("wifidog_v3." .. section .. ".auth_code=" .. tostring(auth_code or ""))
		uci_set("wifidog_v3." .. section .. ".radius_user=")
	end
	uci_set("wifidog_v3." .. section .. ".note=" .. clean_text(saved.note or "", 256))
	uci_set("wifidog_v3." .. section .. ".hostname=" .. clean_text(saved.hostname or "", 128))
	uci_set("wifidog_v3." .. section .. ".user_agent=" .. clean_text(saved.user_agent or "", 512))
	uci_set("wifidog_v3." .. section .. ".ua_device_type=" .. clean_text(saved.ua_device_type or "", 32))
	uci_set("wifidog_v3." .. section .. ".ua_os=" .. clean_text(saved.ua_os or "", 64))
	uci_set("wifidog_v3." .. section .. ".ua_browser=" .. clean_text(saved.ua_browser or "", 64))
	uci_set("wifidog_v3." .. section .. ".ua_model=" .. clean_text(saved.ua_model or "", 96))
	uci_set("wifidog_v3." .. section .. ".ua_summary=" .. clean_text(saved.ua_summary or "", 192))
	uci_set("wifidog_v3." .. section .. ".ua_seen=" .. clean_text(saved.ua_seen or "", 32))
	uci_set("wifidog_v3." .. section .. ".created=" .. tostring(now))
	uci_commit()
	record_client_user_agent(mac, ip)
	remember_ip_session(ip, mac, expiry)
	append_runtime_log("自助认证成功 MAC=" .. mac:upper() .. " IP=" .. tostring(ip or "") .. " 方式=" .. auth_source .. " 有效秒数=" .. tostring(timeout))
	reload_firewall()
	return true, expiry, timeout
end

local function read_body()
	local length = tonumber(os.getenv("CONTENT_LENGTH") or "0") or 0
	if length <= 0 then
		return io.read("*a") or ""
	end
	return io.read(length) or ""
end

local function request_target()
	local uri = os.getenv("REQUEST_URI") or "/"
	local path, query = uri:match("^([^?]*)%??(.*)$")
	return path or "/", query or "", uri
end

local function response(status, content_type, body, extra_headers)
	body = body or ""
	io.write("Status: " .. status .. "\r\n")
	io.write("Content-Type: " .. content_type .. "\r\n")
	io.write("Content-Length: " .. tostring(#body) .. "\r\n")
	io.write("Cache-Control: no-store, no-cache, must-revalidate\r\n")
	for key, value in pairs(extra_headers or {}) do
		io.write(key .. ": " .. value .. "\r\n")
	end
	io.write("\r\n")
	io.write(body)
end

local function json_response(body)
	response("200 OK", "application/json; charset=utf-8", body)
end

local function captive_json_response(body)
	response("200 OK", "application/captive+json", body)
end

local function is_auth_valid(auth_expiry)
	local expiry = tonumber(auth_expiry or "0") or 0
	return expiry > os.time()
end

local function is_unrestricted_device(device)
	if not device then
		return false
	end
	if device.type == "whitelist" then
		return true
	end
	return device.type == "authorized" and is_auth_valid(device.auth_expiry)
end

local function get_device_by_ip_session(ip)
	local sessions, changed = load_ip_sessions()
	local item = sessions[ip or ""]
	if changed then
		save_ip_sessions(sessions)
	end
	if not item or not item.mac then
		return nil
	end

	local device = get_device_by_mac(item.mac)
	if is_unrestricted_device(device) then
		return device
	end

	forget_ip_session(ip)
	return device
end

local function resolve_client_device(ip, mac)
	local device
	if mac and mac ~= "" then
		device = get_device_by_mac(mac)
		if device then
			if is_unrestricted_device(device) then
				remember_ip_session(ip, device.mac or mac, device.auth_expiry)
			else
				forget_ip_session(ip)
			end
			return device
		end
	end

	local session_device = get_device_by_ip_session(ip)
	if mac and mac ~= "" and session_device and session_device.mac and tostring(session_device.mac):upper() ~= tostring(mac):upper() then
		forget_ip_session(ip)
		return nil
	end
	return session_device
end

local function auth_seconds_remaining(device)
	if not device or device.type ~= "authorized" then
		return nil
	end
	local remaining = (tonumber(device.auth_expiry or "0") or 0) - os.time()
	if remaining < 0 then
		remaining = 0
	end
	return remaining
end

local function captive_api_json(device)
	local portal_url = portal_base_url() .. "/portal"
	local parts = {}

	if is_unrestricted_device(device) then
		parts[#parts + 1] = '"captive":false'
		local remaining = auth_seconds_remaining(device)
		if remaining and remaining > 0 then
			parts[#parts + 1] = '"seconds-remaining":' .. tostring(remaining)
		end
		parts[#parts + 1] = '"can-extend-session":false'
	else
		parts[#parts + 1] = '"captive":true'
		parts[#parts + 1] = '"user-portal-url":"' .. json_escape(portal_url) .. '"'
		parts[#parts + 1] = '"can-extend-session":false'
	end

	return "{" .. table.concat(parts, ",") .. "}"
end

