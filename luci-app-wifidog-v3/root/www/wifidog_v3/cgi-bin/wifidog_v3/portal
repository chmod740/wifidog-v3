		]] .. portal_theme_css(theme) .. [[
	</style>
</head>
<body>
	<div class="container">
		<h1>]] .. html_escape(page_title) .. [[</h1>
		<p class="subtitle">]] .. html_escape_multiline(page_prompt) .. [[</p>
		]] .. error_block .. [[
		<form method="POST" action="/portal" id="auth-form">
			<input type="hidden" name="action" value="auth">
			<input type="hidden" name="redirect_url" value="]] .. html_escape(redirect_url) .. [[">
			]] .. method_controls .. code_controls .. radius_controls .. [[
			<button type="submit" id="submit-button" data-button-text="]] .. html_escape(button_text) .. [[">]] .. html_escape(button_text) .. [[</button>
		</form>
		<div class="info">]] .. html_escape_multiline(page_hint) .. [[</div>
	</div>
	<script>
	(function() {
		var form = document.getElementById('auth-form');
		var button = document.getElementById('submit-button');
		var message = document.getElementById('message');
		var buttonText = button.getAttribute('data-button-text') || '认证上网';
		function selectedMethod() {
			var checked = form.querySelector('input[name="auth_method"]:checked');
			var hidden = form.querySelector('input[type="hidden"][name="auth_method"]');
			return (checked && checked.value) || (hidden && hidden.value) || 'code';
		}
		function refreshMethod() {
			var method = selectedMethod();
			Array.prototype.forEach.call(form.querySelectorAll('[data-auth-panel]'), function(panel) {
				var active = panel.getAttribute('data-auth-panel') === method;
				panel.className = active ? 'auth-panel active' : 'auth-panel';
				Array.prototype.forEach.call(panel.querySelectorAll('[data-required-when]'), function(input) {
					input.required = active && input.getAttribute('data-required-when') === method;
					if (active && !form.__focused) {
						input.focus();
						form.__focused = true;
					}
				});
			});
		}
		Array.prototype.forEach.call(form.querySelectorAll('input[name="auth_method"]'), function(input) {
			input.addEventListener('change', function() {
				form.__focused = false;
				refreshMethod();
			});
		});
		refreshMethod();
		function showError(text) {
			message.className = 'message error';
			message.textContent = text || '认证失败';
			message.style.display = 'block';
			button.disabled = false;
			button.textContent = buttonText;
		}
		function fetchJson(url) {
			var sep = url.indexOf('?') >= 0 ? '&' : '?';
			return fetch(url + sep + '_=' + Date.now(), {
				cache: 'no-store',
				headers: { 'Accept': 'application/captive+json, application/json' }
			}).then(function(r) {
				return r.json();
			});
		}
		function fireLegacyProbes() {
			['/generate_204', '/hotspot-detect.html', '/library/test/success.html', '/ncsi.txt'].forEach(function(url) {
				try {
					fetch(url + '?complete=' + Date.now(), { cache: 'no-store' }).catch(function() {});
				} catch (e) {}
			});
		}
		function isAppleCaptiveCandidate() {
			var ua = navigator.userAgent || '';
			return /iPad|iPhone|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
		}
		function tryCloseCaptiveWindow() {
			fireLegacyProbes();
			window.setTimeout(function() {
				try {
					window.open('', '_self');
					window.close();
				} catch (e) {}
			}, 250);
			window.setTimeout(function() {
				if (isAppleCaptiveCandidate()) {
					window.location.href = 'http://captive.apple.com/hotspot-detect.html';
				}
			}, 1300);
		}
		function showSuccess(data) {
			var seconds = parseInt((data && data.wait_seconds) || '3', 10);
			if (!seconds || seconds < 1) seconds = 3;
			document.body.innerHTML = '<div class="container"><h1>认证成功</h1><p class="subtitle">正在确认网络状态，预计 <span id="countdown">' + seconds + '</span> 秒内关闭认证窗口。</p><div class="message success" id="success-message">已提交认证，请稍候...</div><p class="validity" id="auth-validity" hidden></p></div>';
			var countdown = document.getElementById('countdown');
			var successMessage = document.getElementById('success-message');
			var validity = document.getElementById('auth-validity');
			var validParts = [];
			if (data && data.valid_text) validParts.push('有效期：' + data.valid_text);
			if (data && data.expires_at_text) validParts.push('有效期至：' + data.expires_at_text);
			if (validity && validParts.length) {
				validity.textContent = validParts.join('，');
				validity.removeAttribute('hidden');
			}
			var timer = window.setInterval(function() {
				seconds -= 1;
				if (countdown) countdown.textContent = String(Math.max(seconds, 0));
				if (seconds <= 0) window.clearInterval(timer);
			}, 1000);
			pollCaptiveApi((data && data.api_url) || '/captive-portal/api', successMessage);
		}
		function pollCaptiveApi(apiUrl, successMessage) {
			var attempts = 0;
			var maxAttempts = 12;
			function next(delay) {
				window.setTimeout(check, delay);
			}
			function check() {
				attempts += 1;
				fetchJson(apiUrl).then(function(status) {
					if (status && status.captive === false) {
						if (successMessage) successMessage.textContent = '网络状态已确认，正在关闭认证窗口...';
						tryCloseCaptiveWindow();
						return;
					}
					if (attempts >= maxAttempts) {
						if (successMessage) successMessage.textContent = '认证已完成，如窗口未自动关闭请手动关闭。';
						tryCloseCaptiveWindow();
						return;
					}
					if (successMessage) successMessage.textContent = '正在等待系统放行网络...';
					next(1000);
				}).catch(function() {
					if (attempts >= maxAttempts) {
						if (successMessage) successMessage.textContent = '认证已完成，如窗口未自动关闭请手动关闭。';
						tryCloseCaptiveWindow();
						return;
					}
					next(1000);
				});
			}
			next(500);
		}
		form.addEventListener('submit', function(e) {
			e.preventDefault();
			button.disabled = true;
			button.textContent = '正在认证...';
			var body = new URLSearchParams(new FormData(form)).toString();
			fetch('/portal', {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
				body: body,
				cache: 'no-store'
			}).then(function(r) {
				return r.json();
			}).then(function(data) {
				if (data.success) {
					showSuccess(data);
				} else {
					showError(data.message || '认证失败');
				}
			}).catch(function() {
				showError('认证请求失败，请稍后重试');
			});
		});
	})();
	</script>
</body>
</html>]]
end

local function original_url(path, uri)
	local host = os.getenv("HTTP_HOST") or ""
	if host == "" then
		return ""
	end
	if path == "/portal" then
		return ""
	end
	return "http://" .. host .. tostring(uri or "/")
end

local function is_captive_api_path(path)
	path = tostring(path or "")
	return path == "/captive-portal/api"
		or path == "/.well-known/captive-portal"
		or path == "/api/captive-portal"
end

local function legacy_probe_response(path)
	local p = tostring(path or ""):lower()
	if p == "/generate_204" or p == "/gen_204" then
		return "204 No Content", "text/plain; charset=utf-8", ""
	end
	if p == "/hotspot-detect.html" or p == "/library/test/success.html" then
		return "200 OK", "text/html; charset=utf-8", "<HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>"
	end
	if p == "/ncsi.txt" then
		return "200 OK", "text/plain; charset=utf-8", "Microsoft NCSI"
	end
	if p == "/connecttest.txt" then
		return "200 OK", "text/plain; charset=utf-8", "Microsoft Connect Test"
	end
	if p == "/canonical.html" or p == "/connectivity-check.html" then
		return "200 OK", "text/html; charset=utf-8", "NetworkManager is online"
	end
	return nil
end

local function handle()
	local method = os.getenv("REQUEST_METHOD") or "GET"
	local client_ip = get_client_ip()
	local client_mac = get_client_mac(client_ip)
	local device = resolve_client_device(client_ip, client_mac)
	local path, query, uri = request_target()
	local query_form = parse_form(query)
	record_client_user_agent(client_mac, client_ip, path)

	if is_captive_api_path(path) then
		captive_json_response(captive_api_json(device))
		return
	end

	if is_unrestricted_device(device) then
		local status, content_type, body = legacy_probe_response(path)
		if status then
			response(status, content_type, body)
			return
		end
	end

	if device and device.type == "blacklist" then
		if method == "POST" then
			append_runtime_log("黑名单设备尝试自助认证 MAC=" .. tostring(client_mac or "") .. " IP=" .. tostring(client_ip or ""))
			json_response('{"success":false,"message":"当前设备已被拉黑，无法自助授权"}')
		else
			response("200 OK", "text/html; charset=utf-8", blocked_html())
		end
		return
	end

	if method == "POST" then
		local form = parse_form(read_body())
		if form.action == "auth" then
			local code_enabled = option_enabled("auth_code_enabled", "1")
			local radius_enabled = option_enabled("radius_enabled", "0")
			if not code_enabled and not radius_enabled then
				code_enabled = true
			end
			local auth_method = form.auth_method or ""
			if auth_method == "" then
				if form.auth_code and form.auth_code ~= "" then
					auth_method = "code"
				elseif form.radius_username and form.radius_username ~= "" then
					auth_method = "radius"
				else
					auth_method = code_enabled and "code" or "radius"
				end
			end

				if auth_method == "radius" then
					if not radius_enabled then
						append_runtime_log("RADIUS认证失败：功能未启用 IP=" .. tostring(client_ip or ""))
						json_response('{"success":false,"message":"RADIUS认证未启用"}')
						return
					end
					local ok, message, radius_user, session_timeout = radius_authenticate(form.radius_username, form.radius_password, client_mac, client_ip)
					if ok then
						if client_mac == "" then
							append_runtime_log("RADIUS认证失败：无法识别客户端MAC IP=" .. tostring(client_ip or ""))
							json_response('{"success":false,"message":"无法识别客户端MAC地址"}')
							return
						end
						local _, expiry, valid_seconds = authorize_client(client_mac, client_ip, "radius", radius_user, "", session_timeout)
						json_response(auth_success_json(form.redirect_url or "", expiry, valid_seconds))
						return
					end
					append_runtime_log("RADIUS认证失败 MAC=" .. tostring(client_mac or "") .. " IP=" .. tostring(client_ip or "") .. " 用户=" .. clean_text(form.radius_username or "", 128) .. " 原因=" .. tostring(message or ""))
					json_response('{"success":false,"message":"' .. json_escape(message) .. '"}')
					return
				end

				if not code_enabled then
					append_runtime_log("授权码认证失败：功能未启用 IP=" .. tostring(client_ip or ""))
					json_response('{"success":false,"message":"授权码认证未启用"}')
					return
				end
				if not form.auth_code or form.auth_code == "" then
					append_runtime_log("授权码认证失败：未输入授权码 IP=" .. tostring(client_ip or ""))
					json_response('{"success":false,"message":"请输入授权码"}')
					return
				end
				local ok, message, used_code, auth_minutes = validate_auth_code(form.auth_code)
				if ok then
					if client_mac == "" then
						append_runtime_log("授权码认证失败：无法识别客户端MAC IP=" .. tostring(client_ip or ""))
						json_response('{"success":false,"message":"无法识别客户端MAC地址"}')
						return
					end
					local _, expiry, valid_seconds = authorize_client(client_mac, client_ip, "code", used_code, auth_minutes)
					json_response(auth_success_json(form.redirect_url or "", expiry, valid_seconds))
					return
				end
				append_runtime_log("授权码认证失败 MAC=" .. tostring(client_mac or "") .. " IP=" .. tostring(client_ip or "") .. " 原因=" .. tostring(message or ""))
				json_response('{"success":false,"message":"' .. json_escape(message) .. '"}')
				return
		end
		json_response('{"success":false,"message":"无效的请求"}')
		return
	end

	local redirect_url = query_form.redirect_url or query_form.url or original_url(path, uri)
	local error_msg = query_form.error or ""
	response("200 OK", "text/html; charset=utf-8", portal_html(redirect_url, error_msg))
end

handle()
