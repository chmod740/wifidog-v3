#!/usr/bin/env lua

local function trim(s)
	return (s or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function shell_quote(s)
	s = tostring(s or "")
	return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function run(cmd)
	os.execute(cmd .. " >/dev/null 2>&1")
end

local function read_cmd(cmd)
	local fp = io.popen(cmd .. " 2>/dev/null")
	if not fp then
		return ""
	end
	local data = fp:read("*a") or ""
	fp:close()
	return trim(data)
end

local function uci_get(path, default)
	local value = read_cmd("uci -q get " .. shell_quote(path))
	if value == "" then
		return default or ""
	end
	return value
end

local function uci_set(expr)
	run("uci -q set " .. shell_quote(expr))
end

local function uci_delete(path)
	run("uci -q delete " .. shell_quote(path))
end

local function uci_commit()
	run("uci -q commit wifidog_v3")
end

local function get_router_ip()
	return uci_get("network.lan.ipaddr", "192.168.1.1")
end

local function get_portal_port()
	return uci_get("wifidog_v3.settings.portal_port", "8080")
end

local function normalize_auth_minutes(value)
	value = trim(value or "")
	if value == "" then
		return nil
	end
	if not value:match("^%d+$") then
		return nil
	end
	local minutes = tonumber(value)
	if not minutes or minutes < 1 or minutes > 525600 then
		return nil
	end
	return math.floor(minutes)
end

local function effective_auth_timeout(auth_minutes)
	local timeout = normalize_auth_minutes(auth_minutes)
	if not timeout then
		timeout = tonumber(uci_get("wifidog_v3.settings.auth_timeout", "1440")) or 1440
	end
	if timeout < 1 then
		timeout = 1440
	end
	return math.floor(timeout)
end

local function portal_base_url()
	local router_ip = get_router_ip()
	local portal_port = get_portal_port()
	if portal_port == "" or portal_port == "80" then
		return "http://" .. router_ip
	end
	return "http://" .. router_ip .. ":" .. portal_port
end

local function reload_firewall()
	run("/etc/init.d/wifidog_v3 reload")
end

local function urldecode(s)
	s = tostring(s or "")
	s = s:gsub("+", " ")
	s = s:gsub("%%(%x%x)", function(hex)
		return string.char(tonumber(hex, 16))
	end)
	return s
end

local function parse_form(body)
	local form = {}
	for pair in tostring(body or ""):gmatch("[^&]+") do
		local key, value = pair:match("^([^=]*)=?(.*)$")
		if key and key ~= "" then
			form[urldecode(key)] = urldecode(value or "")
		end
	end
	return form
end

local function json_escape(s)
	s = tostring(s or "")
	s = s:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\r", "\\r"):gsub("\n", "\\n")
	return s
end

local function html_escape(s)
	s = tostring(s or "")
	s = s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&#39;")
	return s
end

local function html_escape_multiline(s)
	return html_escape(s):gsub("\r\n", "\n"):gsub("\r", "\n"):gsub("\n", "<br>")
end

local function clean_text(s, max_len)
	s = tostring(s or "")
	s = s:gsub("[%z\001-\008\011\012\014-\031\127]", " ")
	if max_len and #s > max_len then
		s = s:sub(1, max_len)
	end
	return s
end

local function setting_text(key, default, max_len)
	local value = uci_get("wifidog_v3.settings." .. key, "")
	if value == "" then
		value = default or ""
	end
	return clean_text(value, max_len)
end

